{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sparkcall",
  "main": "workers/api/src/index.ts",
  "compatibility_date": "2026-11-02",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "rules": [{ "type": "Text", "globs": ["**/*.yaml"], "fallthrough": true }],
  "upload_source_maps": true,
  "workers_dev": false,
  "routes": [
    { "pattern": "app.example.com", "custom_domain": true }
  ],
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID",
    "ADMIN_USER_IDS": "REPLACE_WITH_ADMIN_USER_IDS"
  },
  "assets": {
    "directory": "./apps/web/dist/",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/callrecords", "/callrecords/*"],
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sparkcall-db",
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "./migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SIGNALING", "class_name": "SparkCallDurableObject" },
      { "name": "PRESENCE", "class_name": "SparkCallPresenceObject" }
    ]
  },
  "exports": {
    "SparkCallDurableObject": { "type": "durable-object", "storage": "sqlite" },
    "SparkCallPresenceObject": { "type": "durable-object", "storage": "sqlite" }
  },
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "observability": { "enabled": true }
}
